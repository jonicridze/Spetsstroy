{
  "name": "sst-corporate",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "build": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4"
  }
}
